# Aether Cloud OS — backend environment template.
#
# Copy to `.env` and adjust. `packages/backend/src/config.ts` is the single
# source of truth for this file: it validates every value at boot, and the
# backend refuses to start on a bad one.
#
# Two rules this file follows, both of which have bitten before:
#   1. No inline comments after a value. Docker Compose's `env_file` parser
#      treats everything after `=` as the value, so `PORT=3000  # http` would
#      become the literal string "3000  # http".
#   2. No secret has a default. Anything left blank that the schema requires
#      (JWT_SECRET; ENCRYPTION_KEY in production) is a startup error, not a
#      silent fallback.
#
# Generate the secrets with:
#   openssl rand -base64 48   # JWT_SECRET, SESSION_SECRET
#   openssl rand -hex 32      # ENCRYPTION_KEY
#
# The production installer writes this file for you; see docs/operations/DEPLOYMENT.md.

# ============================================================================
# RUNTIME
# ============================================================================
NODE_ENV=development

# ============================================================================
# HTTP
# ============================================================================
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000
# Comma-separated. Must include the Vite dev server for local frontend work.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# DATABASE (PostgreSQL, required)
# ============================================================================
# Matches docker-compose.yml. The schema is created by the migration runner at
# startup — never by hand.
DATABASE_URL=postgresql://aether:aether_dev_password@localhost:5432/aether_dev
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ============================================================================
# CACHE (Redis, optional)
# ============================================================================
# When set and reachable, the cache backend is shared across replicas, which is
# required for more than one backend container: WebSocket tickets and rate-limit
# counters live there. When unset, an in-process cache is used and the instance
# must run a single replica. If Redis is configured but unreachable, the backend
# logs the degradation and falls back rather than refusing to start.
REDIS_URL=redis://localhost:6379

# ============================================================================
# SECRETS
# ============================================================================
# Required, minimum 32 characters.
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d
# Required in production. Used to encrypt data at rest; rotating it makes
# existing ciphertext unreadable, so the installer deliberately reuses it across
# upgrades.
ENCRYPTION_KEY=replace-me-with-64-hex-characters
SESSION_SECRET=replace-me-with-another-random-value

# ============================================================================
# LOGGING
# ============================================================================
# `debug`, `trace`, and `pretty` are rejected in production.
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# FILESYSTEM SANDBOX
# ============================================================================
# The only tree the Files app and the terminal may touch. Resolved with
# `fs.realpath` at startup; nothing outside it is reachable.
AETHER_WORKSPACE_ROOT=./workspace
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./uploads

# ============================================================================
# TERMINAL
# ============================================================================
TERMINAL_ENABLED=true
TERMINAL_MAX_SESSIONS=10
TERMINAL_IDLE_TIMEOUT=1800000
TERMINAL_SCROLLBACK_LINES=10000
TERMINAL_ALLOWED_SHELLS=/bin/bash,/bin/sh

# ============================================================================
# FIRST-RUN BOOTSTRAP
# ============================================================================
# When set, creating the first owner account requires this value in the
# `X-Bootstrap-Token` header. Leave blank in development to skip the prompt.
# The installer always generates one so an unclaimed instance cannot be seized.
AETHER_BOOTSTRAP_TOKEN=
# Written by the installer; shown on the Settings → About screen.
AETHER_INSTANCE_ID=

# ============================================================================
# PROCESS MANAGEMENT
# ============================================================================
# Whether the Task Manager may signal processes. Default false: it is the one
# action that can lock an operator out of their own host.
AETHER_PROCESS_SIGNAL_ENABLED=false

# ============================================================================
# STATIC FRONTEND (production only)
# ============================================================================
# Directory holding the built frontend. Leave blank in development; Vite serves
# the UI and proxies to this process instead.
AETHER_STATIC_DIR=

# ============================================================================
# TRUSTED PROXY
# ============================================================================
# Number of reverse proxies in front of the backend (Caddy = 1). Trusting more
# than are actually present lets a client spoof its IP and bypass rate limits.
TRUST_PROXY_HOPS=1
