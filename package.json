{
  "name": "aether-cloud-os",
  "version": "0.1.0",
  "private": true,
  "description": "Universal browser-based desktop environment for VPS and local hosts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFR-projection/Aether-OS.git"
  },
  "author": "Aether Team",
  "license": "PENDING",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "dev:backend": "pnpm --filter @aether/backend dev",
    "dev:frontend": "pnpm --filter @aether/frontend dev",
    "build": "pnpm --recursive run build",
    "build:backend": "pnpm --filter @aether/backend build",
    "build:frontend": "pnpm --filter @aether/frontend build",
    "test": "pnpm --recursive run test",
    "test:backend": "pnpm --filter @aether/backend test",
    "test:shared": "pnpm --filter @aether/shared test",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "pnpm --recursive run typecheck",
    "clean": "pnpm --recursive exec rm -rf dist coverage *.tsbuildinfo",
    "db:migrate": "pnpm --filter @aether/backend db:migrate",
    "docker:dev": "docker compose up -d",
    "docker:dev:stop": "docker compose down",
    "docker:dev:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
