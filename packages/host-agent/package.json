{
  "name": "@aether/host-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aether Cloud OS - Host Agent for local machine access",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aether-agent": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "node-pty": "^1.0.0",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/ws": "^8.5.12",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
