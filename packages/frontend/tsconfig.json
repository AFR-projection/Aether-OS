{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    // The base config sets `composite: true`, which forbids `--noEmit`. This
    // package is a leaf: nothing references its output, so it does not need to
    // be composite. Vite produces the bundle; TypeScript only type checks.
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "incremental": true,

    "types": ["vite/client"],
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
